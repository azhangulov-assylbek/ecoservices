# Скопируйте в .env и заполните. Файл .env НЕ коммитится в git.
DJANGO_SECRET_KEY=сгенерируйте-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=ecoservices.kz,www.ecoservices.kz
DJANGO_CSRF_TRUSTED_ORIGINS=https://ecoservices.kz,https://www.ecoservices.kz
# Подключение к PostgreSQL собирается из этих трёх переменных (хост — сервис db из docker compose).
# Если их не задать, Django возьмёт локальный SQLite.
POSTGRES_DB=ecoservices
POSTGRES_USER=ecoservices
POSTGRES_PASSWORD=сложный-пароль
SITE_EMAIL=info@ecomeken.kz
SITE_PHONE=+7 708 511 5249
