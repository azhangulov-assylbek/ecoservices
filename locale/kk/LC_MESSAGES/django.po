msgid "CO₂ на источниках"
msgstr "көздердегі CO₂"

msgid "ESG-отчёт по P5"
msgstr "P5 бойынша ESG-есебі"

msgid "ecoservices.kz разрабатывает ТОО «ЭКОМЕКЕН», ИТ-компания из Казахстана. Мы соединяем ИТ-экспертизу с практикой в области НДТ, экологического регулирования и устойчивого управления проектами."
msgstr "ecoservices.kz платформасын қазақстандық ИТ-компания «ЭКОМЕКЕН» ЖШС әзірлейді. Біз ИТ-сараптаманы ЕҮҚТ, экологиялық реттеу және жобаларды орнықты басқару саласындағы тәжірибемен ұштастырамыз."

msgid "ecoservices.kz — цифровые сервисы для устойчивого развития предприятий"
msgstr "ecoservices.kz — кәсіпорындардың орнықты дамуына арналған цифрлық сервистер"

msgid "Бета, можно пробовать"
msgstr "Бета, қолданып көруге болады"

msgid "Вклад в Цели устойчивого развития"
msgstr "Орнықты даму мақсаттарына қосқан үлес"

msgid "Внедрить новую технологию"
msgstr "Жаңа технологияны енгізу"

msgid "Вода"
msgstr "Су"

